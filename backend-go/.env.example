# ============================================================================
# Progress Tracker Go Backend (backend-go) — Environment Variable Template
# ============================================================================

# 1. Runtime Environment ("development" | "test" | "production")
ENVIRONMENT=production

# 2. PostgreSQL / Supabase Database Connection (REQUIRED in production; SQLite is rejected in production)
# Use the Supabase Transaction Pooler URI (port 6543) for Vercel serverless deployments:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# 3. Authentication & JWT Secrets (REQUIRED in production; each must be >= 32 characters and unique)
JWT_SECRET=replace-with-32-plus-char-random-jwt-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-random-jwt-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# 4. Internal Go <-> Python PDF Parser Bridge Secret (REQUIRED in production)
# Must be >= 32 characters and cryptographically independent of JWT_SECRET, JWT_REFRESH_SECRET, CLEANUP_SECRET, and CRON_SECRET.
INTERNAL_PARSER_SECRET=replace-with-32-plus-char-independent-parser-secret
# Optional override; on Vercel this is auto-derived from VERCEL_URL as https://<VERCEL_URL>/api/internal_pdf_parser
PYTHON_PARSER_URL=

# 5. Private Supabase Storage for 10 MB PDF Imports (REQUIRED in production)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-secret-key
SUPABASE_STORAGE_BUCKET=pdf-imports
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=200

# 6. Admin Portal & Scheduled Cleanup Secrets
ADMIN_EMAIL=riteeritee251@gmail.com
ADMIN_ACCESS_CODE=replace-with-admin-database-access-code
ADMIN_SESSION_EXPIRE_MINUTES=30
CLEANUP_SECRET=replace-with-16-plus-char-cleanup-secret
CRON_SECRET=replace-with-same-value-as-cleanup-secret

# 7. External Integrations (Google OAuth, Gemini AI, Anthropic Fallback, CORS, SMTP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
CORS_ORIGINS=https://<your-frontend-domain>.vercel.app,http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

