{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.go": {
      "maxDuration": 60,
      "excludeFiles": "{backend-go/tests/**,backend-go/cmd/**,**/__pycache__/**,**/*.pyc}"
    },
    "api/internal_pdf_parser.py": {
      "maxDuration": 30,
      "includeFiles": "pybridge/**",
      "excludeFiles": "{backend-go/tests/**,backend-go/internal/**,backend-go/cmd/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    {
      "source": "/api/internal_pdf_parser",
      "destination": "/api/internal_pdf_parser.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.go"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/admin/cron/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
