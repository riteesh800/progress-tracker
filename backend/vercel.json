{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,**/__pycache__/**,**/*.pyc,.pytest_cache/**,.ruff_cache/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/admin/cron/cleanup",
      "schedule": "0 0 * * *"
    }
  ]
}
