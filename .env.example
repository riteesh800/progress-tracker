# Copy to .env — names only, never commit secrets.

# Postgres (Supabase Transaction Pooler on port 6543 recommended for Vercel Serverless)
# Accepts postgres://, postgresql://, or postgresql+asyncpg:// (with or without ?pgbouncer=true)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# Tests fall back to SQLite if unset
# TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Must be at least 32 characters in production
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ANTHROPIC_API_KEY=

# Comma-separated allowed origins. Vercel URLs are also auto-detected.
CORS_ORIGINS=http://localhost:5173

# SMTP (optional — forgot-password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

ENVIRONMENT=development

# Server-only. Min 12 characters. Never set VITE_ for this.
# ADMIN_ACCESS_CODE=

# Shared secret for Vercel Cron (/api/admin/cron/cleanup or /admin/cron/cleanup).
# Vercel Cron automatically sends CRON_SECRET as a Bearer token.
# CRON_SECRET=
# CLEANUP_SECRET=

# Frontend (Vercel / Vite)
# Leave unset or set to /api when deploying frontend + backend in a single Vercel project.
# Or set to https://your-backend.vercel.app when deploying backend as a separate Vercel project.
# VITE_API_BASE=/api
# VITE_GOOGLE_CLIENT_ID=

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
