# Copy to .env — names only, never commit secrets.

# Postgres (Supabase pooled / pgbouncer, port 6543 in production)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:6543/postgres

# Tests fall back to SQLite if unset
# TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

ANTHROPIC_API_KEY=

# Comma-separated. No wildcard in production.
CORS_ORIGINS=http://localhost:5173

# SMTP (optional — forgot-password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

ENVIRONMENT=development

# Frontend (Vercel / Vite)
# VITE_API_BASE=https://your-render-service.onrender.com
# VITE_GOOGLE_CLIENT_ID=
